{
  "name": "illuzion",
  "label": "Illuzion",
  "order": 2,
  "selector": ".illuzion",
  "scheme": "light",
  "seeds": {
    "background": "#f7cae7",
    "foreground": "#1b1717",
    "primary": "#f2aeda",
    "secondary": "#812961"
  },
  "fonts": {
    "primary": "Bricolage Grotesque",
    "emphasis": "Lora",
    "body": "DM Sans"
  },
  "edges": "strong",
  "overrides": {
    "primary-foreground": "#ff4901",
    "secondary-foreground": "#ee98d0",
    "destructive": "#ff6467",
    "chart-1": "#1447e6",
    "chart-2": "#00bc7d",
    "chart-3": "#fe9a00",
    "chart-4": "#ad46ff",
    "chart-5": "#ff2056"
  },
  "fontSource": "google",
  "tokens": {
    "font-body-weight": "500",
    "font-body-line-height": "1.42",
    "font-body-letter-spacing": "0.01em",
    "background": "oklch(0.886 0.063 339.66)",
    "foreground": "oklch(0.209 0.006 17.68)",
    "card": "var(--background)",
    "card-foreground": "var(--foreground)",
    "popover": "var(--background)",
    "popover-foreground": "var(--foreground)",
    "primary": "oklch(0.828 0.097 340.41)",
    "primary-foreground": "oklch(0.664 0.226 36.11)",
    "secondary": "oklch(0.432 0.136 345.17)",
    "secondary-foreground": "oklch(0.783 0.124 340.98)",
    "muted": "var(--secondary)",
    "muted-foreground": "oklch(0.209 0.006 17.68 / 65%)",
    "accent": "var(--secondary)",
    "accent-foreground": "var(--secondary-foreground)",
    "destructive": "oklch(0.702 0.189 22.23)",
    "affirmative": "oklch(0.548 0.150 145.00)",
    "border": "oklch(0.209 0.006 17.68 / 15%)",
    "input": "oklch(0.209 0.006 17.68 / 20%)",
    "ring": "oklch(0.209 0.006 17.68 / 70%)",
    "alpha-dark-none": "oklch(0.235 0.000 89.88 / 0%)",
    "alpha-dark-xs": "oklch(0.235 0.000 89.88 / 4%)",
    "alpha-dark-sm": "oklch(0.235 0.000 89.88 / 8%)",
    "alpha-dark-md": "oklch(0.235 0.000 89.88 / 16%)",
    "alpha-dark-lg": "oklch(0.235 0.000 89.88 / 32%)",
    "alpha-dark-xl": "oklch(0.235 0.000 89.88 / 80%)",
    "alpha-light-xs": "oklch(0.969 0.002 17.20 / 6%)",
    "alpha-light-sm": "oklch(0.969 0.002 17.20 / 12%)",
    "alpha-light-md": "oklch(0.969 0.002 17.20 / 24%)",
    "alpha-light-lg": "oklch(0.969 0.002 17.20 / 48%)",
    "alpha-light-xl": "oklch(0.969 0.002 17.20 / 96%)",
    "alpha-blur-320-sm": "40px",
    "alpha-blur-1200-sm": "120px",
    "control-fill": "linear-gradient(var(--alpha-light-md), var(--alpha-light-md)), var(--card)",
    "control-edge": "var(--alpha-dark-xs)",
    "control-hover": "var(--alpha-dark-sm)",
    "affirmative-foreground": "oklch(1.000 0.000 0.00)",
    "chart-1": "oklch(0.488 0.243 264.40)",
    "chart-2": "oklch(0.702 0.158 160.44)",
    "chart-3": "oklch(0.772 0.173 65.37)",
    "chart-4": "oklch(0.622 0.259 305.31)",
    "chart-5": "oklch(0.643 0.245 16.50)",
    "gradient-downlight": "linear-gradient(180deg, var(--background) 0%, var(--card) 50%, var(--border) 100%)",
    "gradient-rise": "linear-gradient(180deg, var(--card) 0%, var(--secondary) 100%)",
    "gradient-set": "linear-gradient(180deg, var(--background) 0%, var(--card) 100%)",
    "gradient-headline": "linear-gradient(180deg, var(--foreground) 0%, var(--primary) 100%)",
    "radius": "1rem",
    "radius-container": "1.5rem",
    "dimensions-max": "169px",
    "radius-inner": "0.5rem",
    "radius-outer-max": "1rem",
    "edges-sm": "0.5rem",
    "edges-xs": "0.25rem",
    "edges-md": "1rem",
    "sidebar": "var(--background)",
    "sidebar-foreground": "var(--foreground)",
    "sidebar-primary": "var(--primary)",
    "sidebar-primary-foreground": "var(--primary-foreground)",
    "sidebar-accent": "var(--accent)",
    "sidebar-accent-foreground": "var(--accent-foreground)",
    "sidebar-border": "var(--border)",
    "sidebar-ring": "var(--ring)",
    "shadow-2xs": "none",
    "shadow-xs": "none",
    "shadow-sm": "none",
    "shadow": "none",
    "shadow-md": "none",
    "shadow-lg": "none",
    "shadow-xl": "none",
    "shadow-2xl": "none"
  },
  "figma": {
    "color": "dark",
    "spacing": "md",
    "motion": "smooth",
    "material": "solid",
    "elevation": "none",
    "fonts": {
      "display": {
        "family": "Intan",
        "weight": 400
      },
      "sans": {
        "family": "DM Sans",
        "weight": 500
      },
      "serif": {
        "family": "Lora",
        "weight": 500
      }
    },
    "substitutions": {
      "Intan": "Bricolage Grotesque"
    }
  }
}
