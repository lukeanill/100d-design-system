{
  "name": "laroc",
  "label": "Laroc",
  "order": 3,
  "selector": ".laroc",
  "scheme": "dark",
  "seeds": {
    "background": "#3a6be2",
    "foreground": "#fbfbfc",
    "primary": "#17347b",
    "secondary": "#1b4bbe"
