{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm --filter web run build && STORYBOOK_BASE_PATH=/storybook/ pnpm --filter web run stories:build && rm -rf dist/storybook && mkdir -p dist/storybook && cp -r storybook-static/. dist/storybook/",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/home/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    }
  ],
  "rewrites": [
    {
      "source": "/:path((?!api/|storybook).*)",
      "destination": "/index.html"
    }
  ]
}
