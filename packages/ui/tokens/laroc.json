    "chart-1": "#f54900",
    "chart-2": "#009689",
    "chart-3": "#104e64",
    "chart-4": "#ffb900",
    "chart-5": "#fe9a00"
  },
  "fontSource": "google",
  "tokens": {
    "font-body-weight": "400",
    "background": "oklch(0.562 0.189 264.28)",
