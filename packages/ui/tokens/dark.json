{
  "name": "dark",
  "label": "Dark Mood",
  "order": 1,
  "selector": ".dark",
  "seeds": {
    "background": "#010101",
    "foreground": "#ffffff",
    "primary": "#fffcfa",
    "secondary": "#808080"
  },
  "fonts": {
    "primary": "AUTHENTIC Sans 60",
    "emphasis": "Oranienbaum"
  },
  "edges": "custom",
  "overrides": {},
  "tokens": {
    "background": "oklch(0.067 0.000 0.00)",
    "foreground": "oklch(1.000 0.000 0.00)",
    "card": "oklch(0.248 0.000 0.00)",
    "card-foreground": "oklch(1.000 0.000 0.00)",
    "popover": "oklch(0.248 0.000 0.00)",
    "popover-foreground": "oklch(1.000 0.000 0.00)",
    "primary": "oklch(0.993 0.004 56.38)",
    "primary-foreground": "oklch(0.248 0.000 0.00)",
    "secondary": "oklch(0.600 0.000 0.00)",
    "secondary-foreground": "oklch(0.732 0.000 0.00)",
    "muted": "oklch(0.457 0.000 0.00)",
    "muted-foreground": "oklch(0.873 0.000 0.00)",
    "accent": "oklch(0.600 0.000 0.00)",
    "accent-foreground": "oklch(0.732 0.000 0.00)",
    "destructive": "oklch(0.760 0.139 18.18)",
    "affirmative": "oklch(0.847 0.117 143.45)",
